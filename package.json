{
  "name": "wdio-cucumber-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "WebdriverIO + Cucumber BDD in JavaScript \u2014 the same runner as the Mocha project with the framework adapter swapped, to show what the Gherkin layer costs and buys",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "test": "wdio run ./config/wdio.conf.js",
    "test:headed": "HEADED=1 wdio run ./config/wdio.conf.js",
    "test:smoke": "wdio run ./config/wdio.conf.js --cucumberOpts.tagExpression='@smoke'",
    "test:auth": "wdio run ./config/wdio.conf.js --cucumberOpts.tagExpression='@auth'",
    "test:dry": "wdio run ./config/wdio.conf.js --cucumberOpts.dryRun",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@wdio/allure-reporter": "^9.4.1",
    "@wdio/cli": "^9.4.1",
    "@wdio/cucumber-framework": "^9.4.1",
    "@wdio/globals": "^9.4.1",
    "@wdio/local-runner": "^9.4.1",
    "@wdio/spec-reporter": "^9.4.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-wdio": "^9.31.3",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10"
  }
}
